# Solarized Osaka: adapted from the upstream Hyprland and terminal palettes.
# Mango uses one focus color rather than Hyprland's two-color border gradient.
root_color=0x{{ roles.background|rgba("ff") }}
border_color=0x{{ roles.border|rgba("ff") }}
focus_color=0x{{ roles.accent|rgba("ff") }}
urgent_color=0x{{ roles.error|rgba("ff") }}
drop_color=0x{{ roles.success|rgba("55") }}
split_color=0x{{ roles.warning|rgba("ff") }}
maximized_screen_color=0x{{ roles.success|rgba("ff") }}
scratchpad_color=0x{{ palette.cyan|rgba("ff") }}
global_color=0x{{ palette.magenta|rgba("ff") }}
overlay_color=0x{{ palette.cyan|rgba("ff") }}
shadows_color=0x{{ roles.background|rgba("ff") }}
dim_focused_color=0x{{ roles.background|rgba("00") }}
dim_unfocused_color=0x{{ roles.background|rgba("55") }}
