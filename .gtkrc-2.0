gtk-font-name = "Iosevka Nerd Font 12"

# GTK2 cannot use GTK3 CSS; supply its palette using native RC styles.
style "vague" {
  fg[NORMAL] = "#cdcdcd"
  fg[ACTIVE] = "#d7d7d7"
  fg[PRELIGHT] = "#d7d7d7"
  fg[SELECTED] = "#141415"
  fg[INSENSITIVE] = "#606079"
  bg[NORMAL] = "#141415"
  bg[ACTIVE] = "#252530"
  bg[PRELIGHT] = "#252530"
  bg[SELECTED] = "#6e94b2"
  bg[INSENSITIVE] = "#141415"
  base[NORMAL] = "#141415"
  base[ACTIVE] = "#252530"
  base[PRELIGHT] = "#252530"
  base[SELECTED] = "#6e94b2"
  base[INSENSITIVE] = "#252530"
  text[NORMAL] = "#cdcdcd"
  text[ACTIVE] = "#d7d7d7"
  text[PRELIGHT] = "#d7d7d7"
  text[SELECTED] = "#141415"
  text[INSENSITIVE] = "#606079"
}
class "*" style "vague"
