# Solarized Osaka, adapted from the upstream terminal palette.
set -g status-style 'bg={{ roles.surface }},fg={{ roles.foreground }}'
set -g message-style 'bg={{ roles.surface }},fg={{ roles.bright }}'
set -g message-command-style 'bg={{ roles.surface }},fg={{ roles.accent }}'
set -g mode-style 'bg={{ roles.accent }},fg={{ roles.background }}'
set -g pane-border-style 'fg={{ roles.surface }}'
set -g pane-active-border-style 'fg={{ roles.bright }}'
set -g display-panes-colour '{{ roles.muted }}'
set -g display-panes-active-colour '{{ roles.accent }}'
set -g clock-mode-colour '{{ roles.accent }}'
set -g window-status-style 'bg={{ roles.surface }},fg={{ roles.muted }}'
set -g window-status-current-style 'bg={{ roles.accent }},fg={{ roles.background }},bold'
set -g window-status-activity-style 'fg={{ roles.warning }},bold'
set -g window-status-bell-style 'fg={{ roles.error }},bold'
set -g status-left '#[fg={{ roles.success }},bold]#S #[default]'
set -g status-right '#[fg={{ palette.cyan }}]%H:%M #[fg={{ roles.muted }}]%Y-%m-%d'
