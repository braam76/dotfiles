# Solarized Osaka syntax highlighting and completion menus.
set -g fish_color_normal {{ roles.foreground|hex }}
set -g fish_color_command {{ roles.accent|hex }}
set -g fish_color_keyword {{ roles.success|hex }}
set -g fish_color_quote {{ palette.cyan|hex }}
set -g fish_color_redirection {{ palette.violet|hex }}
set -g fish_color_end {{ roles.warning|hex }}
set -g fish_color_error {{ roles.error|hex }}
set -g fish_color_param {{ roles.bright|hex }}
set -g fish_color_comment {{ roles.muted|hex }}
set -g fish_color_match {{ palette.magenta|hex }}
set -g fish_color_selection --background={{ roles.surface|hex }} {{ roles.bright|hex }}
set -g fish_color_search_match --background={{ roles.surface|hex }} {{ roles.warning|hex }}
set -g fish_color_operator {{ roles.success|hex }}
set -g fish_color_escape {{ palette.magenta|hex }}
set -g fish_color_autosuggestion {{ roles.muted|hex }}
set -g fish_color_valid_path --underline
set -g fish_color_cwd {{ roles.accent|hex }}
set -g fish_color_cwd_root {{ roles.error|hex }}
set -g fish_color_user {{ roles.success|hex }}
set -g fish_color_host {{ palette.cyan|hex }}
set -g fish_color_host_remote {{ palette.violet|hex }}
set -g fish_color_status {{ roles.error|hex }}
set -g fish_color_cancel {{ roles.error|hex }}
set -g fish_pager_color_prefix {{ roles.accent|hex }} --bold
set -g fish_pager_color_completion {{ roles.foreground|hex }}
set -g fish_pager_color_description {{ roles.muted|hex }}
set -g fish_pager_color_progress {{ roles.bright|hex }} --background={{ roles.surface|hex }}
set -g fish_pager_color_selected_background --background={{ roles.surface|hex }}
set -g fish_pager_color_selected_completion {{ roles.bright|hex }}
set -g fish_pager_color_selected_prefix {{ roles.accent|hex }} --bold
set -g fish_pager_color_selected_description {{ roles.bright|hex }}
