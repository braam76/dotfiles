;;; vague-theme.el --- Vague palette -*- lexical-binding: t; -*-
;; Palette: https://github.com/vague-theme/vague
(deftheme vague "Vague dark theme.")
(let ((bg "#141415") (surface "#252530") (fg "#cdcdcd")
      (muted "#606079") (bright "#d7d7d7") (white "#cdcdcd")
      (red "#d8647e") (green "#7fa563") (yellow "#f3be7c")
      (blue "#6e94b2") (magenta "#bb9dbd") (cyan "#aeaed1")
      (iris "#7e98e8"))
  (custom-theme-set-faces
   'vague
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,bright))))
   `(fringe ((t (:background ,bg :foreground ,muted))))
   `(region ((t (:background ,surface :foreground ,bright))))
   `(highlight ((t (:background ,surface))))
   `(hl-line ((t (:background ,surface))))
   `(shadow ((t (:foreground ,muted))))
   `(minibuffer-prompt ((t (:foreground ,blue :weight bold))))
   `(link ((t (:foreground ,blue :underline t))))
   `(link-visited ((t (:foreground ,iris :underline t))))
   `(success ((t (:foreground ,green :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(error ((t (:foreground ,red :weight bold))))
   `(font-lock-builtin-face ((t (:foreground ,cyan))))
   `(font-lock-comment-face ((t (:foreground ,muted :slant italic))))
   `(font-lock-comment-delimiter-face ((t (:inherit font-lock-comment-face))))
   `(font-lock-constant-face ((t (:foreground ,magenta))))
   `(font-lock-doc-face ((t (:foreground ,cyan))))
   `(font-lock-function-name-face ((t (:foreground ,blue))))
   `(font-lock-keyword-face ((t (:foreground ,green :weight bold))))
   `(font-lock-negation-char-face ((t (:foreground ,red))))
   `(font-lock-preprocessor-face ((t (:foreground ,iris))))
   `(font-lock-string-face ((t (:foreground ,cyan))))
   `(font-lock-type-face ((t (:foreground ,yellow))))
   `(font-lock-variable-name-face ((t (:foreground ,blue))))
   `(font-lock-warning-face ((t (:foreground ,red :weight bold))))
   `(line-number ((t (:foreground ,muted :background ,bg))))
   `(line-number-current-line ((t (:foreground ,yellow :background ,surface))))
   `(mode-line ((t (:background ,surface :foreground ,bright :box nil))))
   `(mode-line-inactive ((t (:background ,bg :foreground ,muted :box nil))))
   `(header-line ((t (:background ,surface :foreground ,bright :box nil))))
   `(vertical-border ((t (:foreground ,surface))))
   `(window-divider ((t (:foreground ,surface))))
   `(isearch ((t (:background ,yellow :foreground ,bg :weight bold))))
   `(lazy-highlight ((t (:background ,surface :foreground ,yellow))))
   `(match ((t (:foreground ,yellow :background ,surface :weight bold))))
   `(show-paren-match ((t (:foreground ,magenta :background ,surface :weight bold))))
   `(show-paren-mismatch ((t (:foreground ,white :background ,red))))
   `(diff-added ((t (:foreground ,green :background ,surface))))
   `(diff-removed ((t (:foreground ,red :background ,surface))))
   `(diff-changed ((t (:foreground ,yellow :background ,surface))))
   `(diff-header ((t (:foreground ,blue :background ,surface))))
   `(diff-file-header ((t (:foreground ,bright :background ,surface :weight bold))))
   `(completions-common-part ((t (:foreground ,blue :weight bold))))
   `(completions-first-difference ((t (:foreground ,yellow))))
   `(tab-bar ((t (:background ,bg :foreground ,muted))))
   `(tab-bar-tab ((t (:background ,surface :foreground ,blue :weight bold))))
   `(tab-bar-tab-inactive ((t (:background ,bg :foreground ,muted))))
   `(org-document-title ((t (:foreground ,blue :height 1.3 :weight bold))))
   `(org-level-1 ((t (:foreground ,blue :weight bold))))
   `(org-level-2 ((t (:foreground ,green :weight bold))))
   `(org-level-3 ((t (:foreground ,yellow :weight bold))))
   `(org-code ((t (:foreground ,cyan))))
   `(org-block ((t (:background ,surface))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))))
(provide-theme 'vague)
;;; vague-theme.el ends here
