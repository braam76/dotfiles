# Generated from the shared JSON palette. Edit the template, not this file.
[colors.primary]
background = "{{ roles.background }}"
foreground = "{{ roles.foreground }}"

[colors.cursor]
text = "{{ roles.background }}"
cursor = "{{ roles.bright }}"

[colors.selection]
background = "{{ roles.selection }}"
text = "{{ roles.bright }}"

[colors.normal]
black = "{{ roles.surface }}"
red = "{{ roles.error }}"
green = "{{ roles.success }}"
yellow = "{{ roles.warning }}"
blue = "{{ roles.accent }}"
magenta = "{{ palette.magenta }}"
cyan = "{{ palette.cyan }}"
white = "{{ roles.bright }}"

[colors.bright]
black = "{{ roles.muted }}"
red = "{{ roles.error }}"
green = "{{ roles.success }}"
yellow = "{{ roles.warning }}"
blue = "{{ roles.accent }}"
magenta = "{{ palette.magenta }}"
cyan = "{{ palette.cyan }}"
white = "{{ palette.base3 }}"
