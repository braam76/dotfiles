/* From motorsss/omarchy-solarizedosaka-theme/waybar.css. */
@define-color foreground {{ roles.foreground }};
@define-color background {{ roles.background }};

/* Supporting palette colors for the existing floating-block layout. */
@define-color foreground-inactive {{ roles.muted }};
@define-color surface {{ roles.surface }};
@define-color accent {{ roles.accent }};
@define-color urgent {{ roles.error }};
