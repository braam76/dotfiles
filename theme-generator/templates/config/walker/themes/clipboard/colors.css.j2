/* From motorsss/omarchy-solarizedosaka-theme/walker.css. */
@define-color selected-text {{ roles.accent }};
@define-color text {{ roles.foreground }};
@define-color base {{ roles.background }};
@define-color border {{ palette.violet }};
@define-color foreground {{ roles.foreground }};
@define-color background {{ roles.background }};

/* Aliases and supporting palette colors for the existing clipboard layout. */
@define-color surface {{ roles.surface }};
@define-color muted {{ roles.muted }};
@define-color accent @selected-text;
@define-color error {{ roles.error }};
