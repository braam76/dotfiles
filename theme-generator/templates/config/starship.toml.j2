# Keep Starship's default prompt layout, with Solarized Osaka colors.
palette = "solarized_osaka"

[palettes.solarized_osaka]
black = "{{ roles.background }}"
white = "{{ roles.bright }}"
bright-white = "{{ palette.base3 }}"
red = "{{ roles.error }}"
green = "{{ roles.success }}"
yellow = "{{ roles.warning }}"
blue = "{{ roles.accent }}"
purple = "{{ palette.magenta }}"
cyan = "{{ palette.cyan }}"
bright-black = "{{ roles.muted }}"
bright-red = "{{ roles.error }}"
bright-green = "{{ roles.success }}"
bright-yellow = "{{ roles.warning }}"
bright-blue = "{{ roles.accent }}"
bright-purple = "{{ palette.violet }}"
bright-cyan = "{{ palette.cyan }}"

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
vimcmd_symbol = "[❮](bold green)"

[directory]
style = "bold blue"
read_only_style = "red"

[git_branch]
style = "bold purple"

[git_status]
style = "bold red"

[cmd_duration]
style = "bold yellow"

[username]
style_user = "bold green"
style_root = "bold red"

[hostname]
style = "bold cyan"

[time]
style = "bold bright-black"
